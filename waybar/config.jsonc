{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,

    "modules-left": ["custom/settings", "hyprland/workspaces"],
    "modules-center": ["clock", "custom/weather"],
    "modules-right": ["pulseaudio", "network", "battery"],

    "custom/settings": {
        "format": "󰒓",
        "tooltip-format": "Configurações do sistema",
        "on-click": "gnome-control-center"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },

    "clock": {
        "format": "  {:%H:%M  ·  %d/%m}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 900,
        "tooltip": true
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "  muted",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "  wired",
        "format-disconnected": "  off",
        "tooltip-format": "{essid}"
    },

    "battery": {
        "format": "  {capacity}%",
        "format-charging": "  {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    }
}