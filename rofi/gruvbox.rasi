* {
    bg:       #282828;
    bg-alt:   #3c3836;
    fg:       #ebdbb2;
    fg-alt:   #a89984;
    accent:   #f9f5d7;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    width: 520px;
    padding: 16px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px 14px;
    spacing: 10px;
    margin: 0 0 12px 0;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Buscar...";
    placeholder-color: @fg-alt;
}

listview {
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    spacing: 10px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 22px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
